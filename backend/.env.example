APP_ENV=development
# Preferred on hosted environments. When set, DATABASE_URL takes precedence
# over MYSQL_HOST/PORT/DATABASE/USER/PASSWORD below. Only MySQL URLs are accepted.
# Example format: mysql+pymysql://<user>:<url-encoded-password>@<host>:<port>/<database>
DATABASE_URL=
# If DATABASE_URL is empty, fill HOST, DATABASE, USER and PASSWORD for your MySQL.
# Use the provider's port for managed MySQL; 3306 is the usual local default.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
# TLS is used for MySQL. A CA also enables certificate/hostname verification.
# Example when running from backend/: MYSQL_SSL_CA=certs/ca.pem
# On Render, use the deployed secret-file path instead of a local Windows path.
MYSQL_SSL_CA=
LOG_LEVEL=INFO
SENSOR_GAP_MINUTES=5
# Required for single-admin authentication (Login / Bearer JWT).
# ADMIN_USERNAME: single admin username (e.g. admin)
# ADMIN_PASSWORD: secure password (not empty or placeholder)
# JWT_SECRET_KEY: server-side HS256 secret key (at least 32 bytes)
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES: Access token lifetime in minutes (default: 30)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# Trusted proxies for client IP rate limit resolution (comma-separated IPs/subnets)
TRUSTED_PROXIES=127.0.0.1,::1
# Device IDs, assignments and P-256 public keys are registered through APIs into MySQL.
# Device private keys belong in local config.h / ESP32, not Backend environment variables.
MAX_REQUEST_BODY_BYTES=8192
SIGNED_RATE_LIMIT_PER_MINUTE=120
MAX_SAMPLE_GAP_SECONDS=300
INTEGRITY_BATCH_MAX_RECORDS=100
INTEGRITY_BATCH_MAX_AGE_MINUTES=5
PAYOUT_REQUIRES_ANCHORED_EVIDENCE=true
# Local Hardhat defaults. Keep false until the intended chain/contracts/signers are ready.
# For local integration use blockchain/deployments/localhost.json; for testnet use its real deployment.
# Each contract address and its corresponding signer key must be set together, even when disabled.
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_NETWORK=localhost
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337
# Insurance Contract + Backend Oracle signer (names read by config.py).
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_ORACLE_PRIVATE_KEY=
# Data Integrity Contract + Backend anchorer signer; separate from ESP32 device keys.
DATA_INTEGRITY_CONTRACT_ADDRESS=
BACKEND_ANCHORER_PRIVATE_KEY=
# Optional: path relative to the repository root, or an absolute path.
BLOCKCHAIN_ABI_PATH=backend/app/integrations/abi/ColdChainInsurance.json
DATA_INTEGRITY_ABI_PATH=backend/app/integrations/abi/ColdChainDataIntegrity.json
BLOCKCHAIN_CONFIRMATIONS=1
BLOCKCHAIN_RECEIPT_TIMEOUT_SECONDS=15
# Development origins. For production replace with the actual HTTPS frontend origin(s), no wildcard.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# After deployment: https://<actual-render-service>.onrender.com/api/v1
PUBLIC_API_BASE_URL=
