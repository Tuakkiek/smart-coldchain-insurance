APP_ENV=development
# Preferred on hosted environments. When set, DATABASE_URL takes precedence
# over MYSQL_HOST/PORT/DATABASE/USER/PASSWORD below. Only MySQL URLs are accepted.
# Example format: mysql+pymysql://<user>:<url-encoded-password>@<host>:<port>/<database>
DATABASE_URL=
# If DATABASE_URL is empty, fill HOST, DATABASE, USER and PASSWORD for your MySQL.
# Use the provider's port for managed MySQL; 3306 is the usual local default.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
# TLS is used for MySQL. A CA also enables certificate/hostname verification.
# Example when running from backend/: MYSQL_SSL_CA=certs/ca.pem
# On Render, use the deployed secret-file path instead of a local Windows path.
MYSQL_SSL_CA=
LOG_LEVEL=INFO
SENSOR_GAP_MINUTES=5
# Initial Admin seed only: upgrade-db creates admin_accounts(id=1) if empty.
# Login reads username/password_hash from MySQL after that; changing these never resets it.
# ADMIN_USERNAME / ADMIN_PASSWORD may both be removed after successful bootstrap.
# JWT_SECRET_KEY: server-side HS256 secret key (at least 32 bytes)
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES: Access token lifetime in minutes (default: 30)
# JWT_REFRESH_TOKEN_EXPIRE_DAYS: Lifetime renewed after every successful refresh.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Runtime secret: keep this configured even after removing the bootstrap credentials.
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
# Refresh token is returned only as this HttpOnly cookie. Keep Domain empty for a host-only cookie.
# Local HTTP: Secure=false, SameSite=lax. Production HTTPS: Secure=true.
# Separate *.onrender.com services are cross-site: use SameSite=none in production.
REFRESH_COOKIE_NAME=coldchain_refresh
REFRESH_COOKIE_PATH=/api/v1/auth
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_DOMAIN=
# Trusted proxies for client IP rate limit resolution (comma-separated IPs/subnets)
TRUSTED_PROXIES=127.0.0.1,::1
# Local demo: POST /devices creates a P-256 pair, stores only the public key in
# MySQL, and atomically updates the fixed config.h below. Relative paths are
# resolved from the repository root, never from the process working directory.
# On Render/cloud use DEVICE_PROVISIONING_MODE=manual: a hosted process cannot
# modify config.h on your personal computer and must never claim that it did.
DEVICE_PROVISIONING_MODE=local
DEVICE_CONFIG_PATH=device/cold_chain_device/config.h
MAX_REQUEST_BODY_BYTES=8192
SIGNED_RATE_LIMIT_PER_MINUTE=120
MAX_SAMPLE_GAP_SECONDS=300
INTEGRITY_BATCH_MAX_RECORDS=100
INTEGRITY_BATCH_MAX_AGE_MINUTES=5
PAYOUT_REQUIRES_ANCHORED_EVIDENCE=true
# Local Hardhat defaults. Keep false until the intended chain/contracts/signers are ready.
# For local integration use blockchain/deployments/localhost.json; for testnet use its real deployment.
# Each contract address and its corresponding signer key must be set together, even when disabled.
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_NETWORK=localhost
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337
# Insurance Contract + Backend Oracle signer (names read by config.py).
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_ORACLE_PRIVATE_KEY=
# Optional: Server-side Insurer/Admin signer to auto-call ColdChainInsurance.createPolicy() on Sepolia.
# Never expose this key to Frontend or commit it to Git.
BLOCKCHAIN_INSURER_PRIVATE_KEY=
BLOCKCHAIN_DEFAULT_POLICY_EXPIRY_DAYS=30
# Recommended on Sepolia (e.g. 12145343) so eth_getLogs stays within RPC free-tier block limits.
BLOCKCHAIN_DEPLOY_BLOCK=0
# Data Integrity Contract + Backend anchorer signer; separate from ESP32 device keys.
DATA_INTEGRITY_CONTRACT_ADDRESS=
BACKEND_ANCHORER_PRIVATE_KEY=
# Optional: path relative to the repository root, or an absolute path.
BLOCKCHAIN_ABI_PATH=backend/app/integrations/abi/ColdChainInsurance.json
DATA_INTEGRITY_ABI_PATH=backend/app/integrations/abi/ColdChainDataIntegrity.json
BLOCKCHAIN_CONFIRMATIONS=1
BLOCKCHAIN_RECEIPT_TIMEOUT_SECONDS=15
# Google Maps Geocoding API key (server-side only; never expose to Frontend).
GOOGLE_MAPS_API_KEY=
GEOCODING_FALLBACK_NOMINATIM=true
# Development origins. Credentialed CORS requires exact origins and never permits wildcard.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# After deployment: https://<actual-render-service>.onrender.com/api/v1
PUBLIC_API_BASE_URL=
