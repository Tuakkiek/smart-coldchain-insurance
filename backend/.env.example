APP_ENV=development
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=smart_coldchain
MYSQL_USER=coldchain_app
MYSQL_PASSWORD=
# Optional Aiven project CA certificate for server identity verification.
MYSQL_SSL_CA=
LOG_LEVEL=INFO
SENSOR_GAP_MINUTES=5
# Set a long random value before using device administration endpoints.
ADMIN_API_KEY=
MAX_REQUEST_BODY_BYTES=8192
SIGNED_RATE_LIMIT_PER_MINUTE=120
INTEGRITY_BATCH_MAX_RECORDS=100
INTEGRITY_BATCH_MAX_AGE_MINUTES=5
# Local Hardhat chain only; fill the address from blockchain/deployments/localhost.json
# and the matching oracle private key before setting BLOCKCHAIN_ENABLED=true.
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_NETWORK=localhost
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_ORACLE_PRIVATE_KEY=
# Optional: path relative to the repository root, or an absolute path.
BLOCKCHAIN_ABI_PATH=blockchain/artifacts/contracts/ColdChainInsurance.sol/ColdChainInsurance.json
BLOCKCHAIN_RECEIPT_TIMEOUT_SECONDS=15
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
