# Backend REST API base URL
# Admin signs in via /login. Do not put Admin credentials or JWT secrets in VITE_*.
# Local development. For production set the actual deployed Backend origin.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Mock monitoring data only; login still requires the Backend (true / false).
VITE_USE_MOCK=false

# Enable demo controls tab in development
VITE_ENABLE_DEMO=true

